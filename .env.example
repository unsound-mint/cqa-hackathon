# Copy to .env (git-ignored). Everything is optional: apps start without any of it.
# Never prefix server secrets with VITE_ — Vite ships VITE_* vars to the browser.

# --- api (server-only) ---
PORT=8787
HOST=127.0.0.1
# SQLite file (relative to apps/api); *.sqlite is git-ignored.
DATABASE_PATH=../../data/cqa.sqlite
# Organizer dataset import (full signed URL stays here, never in the browser or git).
DATASET_IMPORT_URL=
# Model provider keys (leave empty until a provider adapter exists).
ANTHROPIC_API_KEY=

# --- web ---
# Unset/empty: development uses mock fixtures; pnpm start uses the real HTTP backend.
# Set mock explicitly only for a fictional preview, or http for integrated development.
VITE_API_MODE=

# Model used by the baseline evaluator (default claude-haiku-5-5). Requires ANTHROPIC_API_KEY.
CQA_MODEL=
# Thinking depth: low | medium | high | xhigh | max (default medium). Haiku 5.5 takes no temperature/top_p/top_k.
CQA_EFFORT=

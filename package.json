{
  "name": "cqa-hackathon",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cqa/web --filter @cqa/api dev",
    "dev:web": "pnpm --filter @cqa/web dev",
    "dev:api": "pnpm --filter @cqa/api dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "seed": "node scripts/seed.mjs",
    "seed:export": "node scripts/export-seed.mjs",
    "prod": "node scripts/prod.mjs",
    "stop": "node scripts/stop.mjs",
    "results:check": "node scripts/export-results.mjs --check",
    "start": "pnpm build && pnpm --filter @cqa/api start"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "better-sqlite3"] }
}
